# Copy this file to .env and fill in only the credentials required by the
# example you want to run. Values exported in your shell take precedence.

# Gateway examples: gateway-chat, gateway-models, gateway-stream.
OWLVIGIL_GATEWAY_KEY=

# Management examples: management-key, management-usage, team-management,
# financial-control, billing-subscription, and openapi-smoke.
OWLVIGIL_API_KEY=

# Optional staging key for examples/multi-environment.
OWLVIGIL_STAGING_API_KEY=

# Optional local key for examples/multi-environment.
OWLVIGIL_LOCAL_API_KEY=

# OAuth examples. Set CLIENT_ID and CLIENT_SECRET for client credentials or
# authorization-code exchange. ACCESS_TOKEN may be used instead by oauth2-smoke.
OWLVIGIL_CLIENT_ID=
OWLVIGIL_CLIENT_SECRET=
OWLVIGIL_ACCESS_TOKEN=
OWLVIGIL_REFRESH_TOKEN=
OWLVIGIL_AUTH_CODE=
OWLVIGIL_SCOPE="workspace:read profile:read"
OWLVIGIL_REDIRECT_URI="http://localhost:3000/oauth/callback"
OWLVIGIL_CODE_VERIFIER=
OWLVIGIL_STATE=test_state
OWLVIGIL_REVOKE_TOKEN=false
OWLVIGIL_PRINT_TOKENS=false
OWLVIGIL_LIVE_TEST=false

# Optional environment controls.
OWLVIGIL_ENV=production
OWLVIGIL_WORKSPACE_ID=

# Full Open API smoke controls. Keep writes disabled for shared accounts.
OWLVIGIL_SMOKE_WRITES=0
OWLVIGIL_SMOKE_REQUIRE_ALL=0
OWLVIGIL_SMOKE_PROVIDER_TYPE=openai
OWLVIGIL_SMOKE_PROVIDER_API_KEY=
OWLVIGIL_SMOKE_PROVIDER_BASE_URL=
OWLVIGIL_SMOKE_CURRENT_PASSWORD=
OWLVIGIL_SMOKE_NEW_PASSWORD=
OWLVIGIL_SMOKE_INVITE_EMAIL=
OWLVIGIL_SMOKE_MEMBER_EMAIL=
OWLVIGIL_SMOKE_WORKSPACE_INVITE_EMAIL=
OWLVIGIL_SMOKE_POLICY_ID=
OWLVIGIL_SMOKE_AUDIT_LOG_ID=
OWLVIGIL_SMOKE_MODEL_ID=
OWLVIGIL_SMOKE_ROUTE_ID=
OWLVIGIL_SMOKE_REQUEST_ID=
OWLVIGIL_SMOKE_TRACE_ID=
OWLVIGIL_SMOKE_PAYLOAD_ID=
OWLVIGIL_SMOKE_PLAN_ID=
OWLVIGIL_SMOKE_PLAN_INTERVAL=
OWLVIGIL_SMOKE_TOPUP_ID=
OWLVIGIL_SMOKE_INVOICE_ID=
OWLVIGIL_SMOKE_ORDER_ID=
OWLVIGIL_SMOKE_WEBHOOK_URL=
OWLVIGIL_SMOKE_WEBHOOK_EVENT_ID=
OWLVIGIL_SMOKE_BUDGET_SCOPE_TYPE=
OWLVIGIL_SMOKE_BUDGET_SCOPE_ID=
OWLVIGIL_SMOKE_BUDGET_ENABLED=
OWLVIGIL_SMOKE_BUDGET_MONTHLY_AMOUNT=
OWLVIGIL_SMOKE_SPENDING_USER_ID=
OWLVIGIL_SMOKE_SPENDING_DAILY_LIMIT=
OWLVIGIL_SMOKE_SPENDING_WEEKLY_LIMIT=
OWLVIGIL_SMOKE_SPENDING_MONTHLY_LIMIT=
OWLVIGIL_SMOKE_TOPUP_AMOUNT=
OWLVIGIL_SMOKE_SUCCESS_URL=
OWLVIGIL_SMOKE_CANCEL_URL=
OWLVIGIL_SMOKE_RETURN_URL=
OWLVIGIL_SMOKE_STRIPE_ORDER_ID=
OWLVIGIL_SMOKE_STRIPE_SESSION_ID=
OWLVIGIL_SMOKE_TOPUP_PAYMENT_INTENT_ID=
OWLVIGIL_SMOKE_TOPUP_CLIENT_SECRET=
OWLVIGIL_SMOKE_UPGRADE_PLAN_ID=
OWLVIGIL_SMOKE_UPGRADE_INTERVAL=
OWLVIGIL_SMOKE_DOWNGRADE_PLAN_ID=
OWLVIGIL_SMOKE_DOWNGRADE_INTERVAL=
OWLVIGIL_STRIPE_TEST_PAYMENT_METHOD_ID=
OAUTH_CALLBACK_ADDR=localhost:3000
OAUTH_CALLBACK_PATH=/oauth/callback
